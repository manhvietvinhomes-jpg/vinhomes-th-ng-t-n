{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "royal-snow-1e06",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/", "/robots.txt", "/sitemap.xml", "/admin/*", "/tong-quan/*", "/vi-tri/*", "/quy-hoach/*", "/san-pham/*", "/gia-ban/*", "/mat-bang/*", "/tien-do/*", "/phap-ly/*", "/so-sanh/*", "/tin-tuc/*", "/chinh-sach-bao-mat/*"]
  },
  "kv_namespaces": [
    {"binding": "OLYMPIC_KV", "id": "DIEN_ID_KV_CUA_BAN_VAO_DAY"}
  ]
}
