{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "royal-snow-1e06",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/",
      "/robots.txt",
      "/sitemap.xml",
      "/admin/*",
      "/tong-quan/*",
      "/vi-tri/*",
      "/quy-hoach/*",
      "/san-pham/*",
      "/gia-ban/*",
      "/mat-bang/*",
      "/tien-do/*",
      "/phap-ly/*",
      "/so-sanh/*",
      "/tin-tuc/*",
      "/chinh-sach-bao-mat/*",
      "/quan-tri-mv-7f3a/*",
      "/gioi-thieu/*",
      "/lien-he/*",
      "/tac-gia-manh-viet/*",
      "/chinh-sach-bien-tap/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OLYMPIC_KV",
      "id": "696ba460fa564addb78e097ff35b2553"
    }
  ],
  "account_id": "7f108a2514f542b5a8ee9da952730816"
}
